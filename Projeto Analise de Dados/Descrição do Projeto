    npk_n = randf(10,80)
    npk_p = randf(5,50)
    npk_k = randf(10,80)
    temperatura_ar = randf(10,38)
    pressao = randf(980,1030)
    altitude = randf(400,900)
    umidade_relativa = randf(20,98)
    radiacao_solar = randf(0,1200)
